<?xml version='1.0' encoding='UTF-8'?>
<faces-config version="2.0"
              xmlns="http://java.sun.com/xml/ns/javaee" 
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
              xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-facesconfig_2_0.xsd">
     
    <validator>
        <validator-id>subcontractedDepartmentValidator</validator-id>
        <validator-class>jm.com.dpbennett.hrm.validator.SubcontractedDepartmentValidator</validator-class>
    </validator>    
    <validator>
        <validator-id>manufacturerValidator</validator-id>
        <validator-class>jm.com.dpbennett.hrm.validator.ManufacturerValidator</validator-class>
    </validator>      
    <navigation-rule>
