            <from-outcome>employeePositionDialog</from-outcome>
            <to-view-id>/hr/employeePositionDialog.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>
    <navigation-rule>
        <from-view-id>/index-m.xhtml</from-view-id>
        <navigation-case>
            <from-outcome>employeePositionDialog-m</from-outcome>
            <to-view-id>/hr/employeePositionDialog-m.xhtml</to-view-id>
        </navigation-case>
    </navigation-rule>
